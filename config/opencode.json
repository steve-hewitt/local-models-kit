{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "models": {
        "flint-opencode:latest": {
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "name": "Flint 40B, context-pinned 128K",
          "tool_call": true
        },
        "qwen-opencode:latest": {
          "limit": {
            "context": 131072,
            "output": 8192
          },
          "name": "Qwen3 30B A3B, context-pinned 128K",
          "tool_call": true
        }
      },
      "name": "Ollama (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "whitelist": [
        "flint-opencode:latest",
        "qwen-opencode:latest"
      ]
    },
    "headroom": {
      "models": {
        "flint-opencode:latest": {
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "name": "Flint 40B, context-pinned 128K, via Headroom",
          "tool_call": true
        },
        "qwen-opencode:latest": {
          "limit": {
            "context": 131072,
            "output": 8192
          },
          "name": "Qwen3 30B A3B, context-pinned 128K, via Headroom",
          "tool_call": true
        }
      },
      "name": "Headroom proxy (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      },
      "whitelist": [
        "flint-opencode:latest",
        "qwen-opencode:latest"
      ]
    }
  }
}
