# Environment knobs for the scripts. No .env file is read; export these
# in your shell or set them inline before running a script.
# No secrets live here; the stack needs no API keys.

# Primary model tag. Setup pulls it and builds the matching pinned variant.
MODEL_TAG=flint

# Qwen is the other first-class model. The installer includes it by default;
# on the manual path, set WITH_QWEN=1, or set MODEL_TAG=qwen3:30b-a3b to make
# Qwen the primary.
WITH_QWEN=0
QWEN_TAG=qwen3:30b-a3b
QWEN_CUSTOM_TAG=qwen-opencode

# Primary pinned variant.
CUSTOM_MODEL_TAG=flint-opencode

# Context window. 131072 is the kit default; Flint can go to 262144, Qwen
# stays at 131072 (its YaRN ceiling).
NUM_CTX=131072
QWEN_NUM_CTX=131072

# Ollama endpoint (OpenAI-compatible surface at /v1).
OLLAMA_HOST=http://localhost:11434

# Headroom proxy port.
HEADROOM_PORT=8787

# Headroom telemetry off.
HEADROOM_TELEMETRY=off
HEADROOM_BEACON=off
DO_NOT_TRACK=1

# OpenCode global config:
# Windows %USERPROFILE%\.config\opencode\opencode.json
# Linux/macOS ~/.config/opencode/opencode.json
